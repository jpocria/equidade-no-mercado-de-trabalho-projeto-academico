<mxfile host="app.diagrams.net" modified="2026-10-15T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="equidade-a3" name="Fluxograma"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Fluxograma - Analisador de Anúncios de Vaga" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="55" y="25" width="750" height="40" as="geometry"/></mxCell><mxCell id="authors" value="João Pedro Antunes e Tulio Amaral | Algoritmos e Programação | E2" style="text;html=1;fontSize=14;fontColor=#3F4E5E;" vertex="1" parent="1"><mxGeometry x="55" y="70" width="700" height="30" as="geometry"/></mxCell><mxCell id="panel" value="&lt;b&gt;Detalhamento das subrotinas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;normalizar_texto:&lt;/b&gt; receber texto -&gt; strip() e lower() -&gt; retornar texto normalizado&lt;br&gt;&lt;b&gt;analisar_vaga:&lt;/b&gt; criar lista -&gt; percorrer termos -&gt; verificar exceção e ocorrência -&gt; retornar índices&lt;br&gt;&lt;b&gt;calcular_percentual:&lt;/b&gt; quantidade / total x 100 -&gt; retornar decimal" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F2F2F2;strokeColor=#AAB7C4;fontSize=14;fontColor=#17202A;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="1490" height="240" as="geometry"/></mxCell><mxCell id="start" value="Início" style="whiteSpace=wrap;html=1;strokeColor=#3F4E5E;fontColor=#17202A;fontSize=13;ellipse;fillColor=#17365D;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="135" height="58" as="geometry"/></mxCell><mxCell id="intro" value="Exibir título e aviso:&#xa;não é parecer jurídico" style="whiteSpace=wrap;html=1;strokeColor=#3F4E5E;fontColor=#17202A;fontSize=13;shape=parallelogram